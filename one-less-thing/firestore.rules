rules_version = '2';
// Security rules for One Less Thing!
// Paste into Firebase console → Firestore Database → Rules, then Publish.
// Replace ADMIN_EMAIL_HERE with the Google account(s) that may open the Master list.
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in [
          'ADMIN_EMAIL_HERE'
        ];
    }
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // One document per person: { items: [ {id, text, why, time, at}, ... ] }
    // Teachers can read and add to their own document only. Only the admin can read everyone's.
    match /responses/{uid} {
      allow read: if isAdmin() || isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['items'])
        && request.resource.data.items is list
        && request.resource.data.items.size() <= 50;
      allow delete: if isAdmin();
    }

    // The public list: anyone with the link can read it, only the admin can change it.
    match /list/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Admin-only bookkeeping (which submissions were set aside).
    match /triage/{doc} {
      allow read, write: if isAdmin();
    }

    // Everything else is closed.
    match /{path=**} {
      allow read, write: if false;
    }
  }
}
